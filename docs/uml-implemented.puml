@startuml
title Study Mode - implemented through M2 persistence (15 November 2026)
hide empty members
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package "domain (models)" {
  class Validation <<utility>>
  class UserProfile <<record>> {
    id : UUID
    displayName : String
    createdAt : Instant
    studyZone : ZoneId
    withDetails(name, zone) : UserProfile
  }
  class StudyResource <<record>> {
    id : UUID
    uri : URI
    fromUrl(id, title, url) : StudyResource
  }
  class Classroom <<record>> {
    resources : List<StudyResource>
  }
  class FocusWorkspace <<record>> {
    classroomId : UUID
    resourceIds : Set<UUID>
    blocklist : Set<BlockedApplication>
    validateAgainst(classroom)
  }
  class FocusPreferences <<record>>
  class BlockedApplication {
    executablePath : Path
    equals(other) : boolean
    hashCode() : int
  }
  class StudySession <<record>> {
    profileId : UUID
    startedAt : Instant
    endedAt : Instant
    activeFocusSeconds : long
    status : SessionStatus
    finished() : boolean
  }
  enum SessionStatus {
    ACTIVE
    PAUSED
    COMPLETED
    INTERRUPTED
  }
  class StudyGoal <<record>>
  enum GoalPeriod {
    DAILY
    WEEKLY
  }
  class StudyTask <<record>> {
    complete(at) : StudyTask
  }
  class Achievement <<record>>
  class AchievementAward <<record>> {
    achievementCode : String
  }
}
package "application.port" {
  interface UserProfileStore {
    findLocalProfile() : Optional<UserProfile>
    save(profile)
    delete(id) : boolean
  }
  interface StudySessionLedger {
    save(session)
    findByPeriod(from, to) : List<StudySession>
    find(id) : Optional<StudySession>
    delete(id) : boolean
  }
  interface DistractionBlocker {
    start(targets : Set<BlockedApplication>)
    stop()
    isRunning() : boolean
    selectedTargets() : Set<BlockedApplication>
    events() : List<String>
  }
}
package "application.service / application.error" {
  class ProfileService {
    load() : Optional<UserProfile>
    saveDetails(name, zone) : UserProfile
  }
  class StudyDataException <<custom runtime exception>>
  class FocusModeException <<custom runtime exception>>
}
package "persistence.sqlite" {
  class SqliteDatabase {
    open() : Connection
  }
  class SchemaMigrator {
    migrate()
  }
  class SqliteUserProfileStore
  class SqliteStudySessionLedger
}
package "persistence.config" {
  class StartupConfiguration <<record>>
  class StartupConfigurationLoader {
    load(arguments, environment) : StartupConfiguration
    saveWindowPreferences(root, width, height)
  }
  class DataDirectoryLock {
    acquire(root) : DataDirectoryLock
    close()
  }
}
package "platform.simulation" {
  class SimulatedDistractionBlocker
}
package "ui / ui.view / ui.controller" {
  class AppShell
  enum NavigationPage
  class ProfileController
  class MilestoneInfoView
  class ViewComponents <<utility>>
}
package "bootstrap" {
  class StudyModeLauncher
  class StudyModeApplication
}

Classroom "1" o-- "0..*" StudyResource : immutable list
FocusWorkspace "1" --> "1" FocusPreferences
FocusWorkspace "0..*" o-- "0..*" BlockedApplication : immutable set
FocusWorkspace ..> Classroom : validates ID and resource membership
FocusWorkspace ..> StudyResource : selected IDs
StudySession --> SessionStatus
StudySession "0..*" ..> "1" UserProfile : profile UUID; database FK
StudyGoal --> GoalPeriod
StudyGoal ..> UserProfile : profile UUID
StudyTask ..> UserProfile : profile UUID
StudyTask ..> Classroom : optional UUID
StudyTask ..> StudyGoal : optional UUID
AchievementAward ..> UserProfile : profile UUID
AchievementAward ..> Achievement : achievement code
UserProfile ..> Validation
Classroom ..> Validation
StudyResource ..> Validation
FocusWorkspace ..> Validation
FocusPreferences ..> Validation
BlockedApplication ..> Validation
StudySession ..> Validation
StudyGoal ..> Validation
StudyTask ..> Validation
Achievement ..> Validation
AchievementAward ..> Validation

UserProfileStore <|.. SqliteUserProfileStore
StudySessionLedger <|.. SqliteStudySessionLedger
DistractionBlocker <|.. SimulatedDistractionBlocker
ProfileService --> UserProfileStore
ProfileService ..> UserProfile
SqliteUserProfileStore --> SqliteDatabase
SqliteStudySessionLedger --> SqliteDatabase
SchemaMigrator --> SqliteDatabase
SqliteDatabase ..> StudyDataException : translates failures
SqliteUserProfileStore ..> StudyDataException
SqliteStudySessionLedger ..> StudyDataException
SimulatedDistractionBlocker ..> FocusModeException
SimulatedDistractionBlocker o-- BlockedApplication
StartupConfigurationLoader ..> StartupConfiguration
StartupConfiguration ..> Validation

StudyModeLauncher ..> StudyModeApplication : launches
StudyModeApplication --> DataDirectoryLock
StudyModeApplication --> DistractionBlocker
StudyModeApplication ..> SimulatedDistractionBlocker : constructs
StudyModeApplication ..> StudySessionLedger
StudyModeApplication ..> SqliteStudySessionLedger : constructs / reads
StudyModeApplication ..> SqliteUserProfileStore : constructs
StudyModeApplication ..> SqliteDatabase : constructs
StudyModeApplication ..> SchemaMigrator
StudyModeApplication ..> ProfileService : wires
StudyModeApplication --> StartupConfigurationLoader
StudyModeApplication ..> AppShell : constructs
AppShell --> ProfileController
AppShell --> DistractionBlocker : reads status
AppShell --> StartupConfiguration
AppShell --> StartupConfigurationLoader : saves preferences
AppShell --> NavigationPage
AppShell ..> MilestoneInfoView
AppShell ..> ViewComponents
ProfileController --> ProfileService
ProfileController ..> ViewComponents
ProfileController ..> Validation
MilestoneInfoView --> NavigationPage
MilestoneInfoView ..> ViewComponents

package "M2 application ports and snapshot data" {
  interface ClassroomCatalog
  interface FocusWorkspaceStore
  interface BlockedApplicationCatalog
  interface StudyPlanStore
  interface AchievementStore
  interface StudyDataArchive
  interface StudyDataTransfer
  class StudyDataSnapshot <<record>>
  class ApplicationSelection <<nested record>>
  class WorkspaceSelection <<nested record>>
  class SnapshotValidator
  class DataImportException <<custom runtime exception>>
}
package "M2 persistence and transfer adapters" {
  class SqliteClassroomCatalog
  class SqliteFocusWorkspaceStore
  class SqliteBlockedApplicationCatalog
  class SqliteStudyPlanStore
  class SqliteAchievementStore
  class SqliteStudyDataArchive
  class SqliteStatements <<package utility>>
  interface SqlOperation <<nested>>
  interface RowReader <<nested>>
  class JsonStudyDataTransfer
  class StudyJsonStructureValidator
}
package "M2 UI controllers" {
  class ClassroomController
  class DataTransferController
}
ClassroomCatalog <|.. SqliteClassroomCatalog
FocusWorkspaceStore <|.. SqliteFocusWorkspaceStore
BlockedApplicationCatalog <|.. SqliteBlockedApplicationCatalog
StudyPlanStore <|.. SqliteStudyPlanStore
AchievementStore <|.. SqliteAchievementStore
StudyDataArchive <|.. SqliteStudyDataArchive
StudyDataTransfer <|.. JsonStudyDataTransfer
SqliteClassroomCatalog --> SqliteDatabase
SqliteFocusWorkspaceStore --> SqliteDatabase
SqliteBlockedApplicationCatalog --> SqliteDatabase
SqliteStudyPlanStore --> SqliteDatabase
SqliteAchievementStore --> SqliteDatabase
SqliteStudyDataArchive --> SqliteDatabase
SqliteDatabase +-- SqlOperation
SqliteStatements +-- RowReader
SqliteClassroomCatalog ..> SqliteStatements
SqliteFocusWorkspaceStore ..> SqliteStatements
SqliteBlockedApplicationCatalog ..> SqliteStatements
SqliteStudyPlanStore ..> SqliteStatements
SqliteAchievementStore ..> SqliteStatements
SqliteStudyDataArchive ..> SqliteClassroomCatalog : shared-transaction reads/writes
SqliteStudyDataArchive ..> SqliteFocusWorkspaceStore
SqliteStudyDataArchive ..> SqliteBlockedApplicationCatalog
SqliteStudyDataArchive ..> SqliteStudyPlanStore
SqliteStudyDataArchive ..> SqliteAchievementStore
SqliteStudyDataArchive ..> SqliteUserProfileStore
SqliteStudyDataArchive ..> SqliteStudySessionLedger
SqliteStudyDataArchive ..> StudyDataSnapshot
SqliteStudyDataArchive ..> SnapshotValidator
JsonStudyDataTransfer --> StudyDataArchive
JsonStudyDataTransfer --> SnapshotValidator
JsonStudyDataTransfer --> StudyJsonStructureValidator : checks raw JSON before binding
StudyJsonStructureValidator ..> StudyDataSnapshot : reads record type metadata
StudyJsonStructureValidator ..> DataImportException
JsonStudyDataTransfer ..> DataImportException
SnapshotValidator ..> DataImportException
SnapshotValidator ..> StudyDataSnapshot
StudyDataSnapshot +-- ApplicationSelection
StudyDataSnapshot +-- WorkspaceSelection
StudyDataSnapshot o-- UserProfile
StudyDataSnapshot o-- StudySession
StudyDataSnapshot o-- Classroom
StudyDataSnapshot o-- StudyGoal
StudyDataSnapshot o-- StudyTask
StudyDataSnapshot o-- Achievement
StudyDataSnapshot o-- AchievementAward
WorkspaceSelection --> FocusPreferences
WorkspaceSelection ..> FocusWorkspace : reconstructs
ApplicationSelection ..> BlockedApplication : reconstructs metadata
AppShell --> ClassroomController
AppShell --> DataTransferController
ClassroomController --> ClassroomCatalog
DataTransferController --> StudyDataTransfer
DataTransferController ..> StudyDataSnapshot
StudyModeApplication ..> SqliteClassroomCatalog : constructs
StudyModeApplication ..> SqliteStudyDataArchive : constructs
StudyModeApplication ..> JsonStudyDataTransfer : constructs

note bottom of StudyModeApplication
  Domain models have no JavaFX/JDBC dependencies.
  I/O is serialized off the FX application thread.
  Native Windows blocking and later workflows are absent.
end note
@enduml
